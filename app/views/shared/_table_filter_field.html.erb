<%# locals: (placeholder: "Search…") %>
<%# instant search box for a list wrapped in data-controller="table-filter" %>
<div class="border-b border-white/70 p-3 print:hidden">
  <div class="relative max-w-md">
    <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400"><%= icon(:search, "h-4 w-4") %></span>
    <input type="search" class="inp pl-9" placeholder="<%= placeholder %>" autocomplete="off" aria-label="Search"
           data-table-filter-target="input" data-action="input->table-filter#filter">
  </div>
  <p class="mt-2 text-sm text-slate-500" data-table-filter-target="empty" hidden>Nothing matches your search.</p>
</div>
