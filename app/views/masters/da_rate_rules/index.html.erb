<% content_for :title, "Special DA Rate" %>
<%= page_header("Special DA Rate", "DA rate for some employees by position. Everyone else gets the City & DA Rate master rate. If several rules fit: Employee → Designation → Level; a city rule before an “All cities” rule.", icon_name: :rupee) do %>
  <%= link_to masters_cities_path, class: "btn-light" do %><%= icon(:building) %> City & DA Rate<% end %>
  <%= print_button %>
<% end %>
<div class="grid gap-5 xl:grid-cols-[360px_1fr]">
  <div class="card h-fit fade-up">
    <div class="card-head"><span class="card-title"><span class="icon-chip bg-emerald-50 text-emerald-600"><%= icon(:plus) %></span>Add special rate</span></div>
    <%= render "form", rule: @rule %>
  </div>
  <div class="card overflow-hidden fade-up" data-controller="table-filter">
    <%= render "shared/table_filter_field", placeholder: "Search level, designation, employee, city…" %>
    <table class="tbl tbl-stack">
      <thead><tr><th>Applies to</th><th>City</th><th class="text-right">DA rate / day</th><th>Status</th><th>Remark</th><th class="no-print"></th></tr></thead>
      <tbody data-table-filter-target="body">
        <% @rules.each do |r| %>
          <tr>
            <td data-label="Applies to"><span class="text-xs font-semibold uppercase text-slate-400"><%= DaRateRule::TYPES[r.match_type] %></span><div class="font-semibold text-slate-900"><%= r.match_value %></div></td>
            <td data-label="City"><%= r.city_label %></td>
            <td data-label="DA rate" class="font-semibold md:text-right"><%= inr(r.da_rate) %></td>
            <td data-label="Status"><%= r.active? ? tag.span("Active", class: "badge badge-dot bg-emerald-50 text-emerald-700 ring-emerald-200") : tag.span("Off", class: "badge badge-dot bg-slate-50 text-slate-500 ring-slate-200") %></td>
            <td data-label="Remark" class="text-sm text-slate-600"><%= r.remark.presence || "—" %></td>
            <td class="no-print"><div class="flex justify-end gap-1.5">
              <%= link_to edit_masters_da_rate_rule_path(r), class: "btn-light btn-xs" do %><%= icon(:pencil) %> Edit<% end %>
              <%= button_to masters_da_rate_rule_path(r), method: :delete, class: "btn-soft-danger btn-xs", form_class: "inline", data: { turbo_confirm: "Remove this special DA rate? #{r.applies_to} will get the city rate again." } do %><%= icon(:trash) %><% end %>
            </div></td>
          </tr>
        <% end %>
        <%= empty_row(6, "No special DA rate yet – everyone gets the city rate.") if @rules.empty? %>
      </tbody>
    </table>
  </div>
</div>
